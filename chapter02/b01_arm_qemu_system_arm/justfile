project_name := `basename "$(pwd)"`
target_machine := "aarch64-unknown-none"

qemu:
    cargo build --target {{target_machine}}
    qemu-system-aarch64 \
        -machine virt \
        -cpu cortex-a53 \
        -m 256M \
        -kernel target/{{target_machine}}/debug/{{project_name}} \
        -display cocoa \
        -serial stdio \
        -monitor none

    

